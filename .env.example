# --- NOW environment variables ---

# REQUIRED: Mapbox GL public access token.
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# OPTIONAL: Custom Mapbox Studio style URL for the premium NOW look.
# Falls back to "mapbox://styles/mapbox/dark-v11" when unset.
VITE_MAPBOX_STYLE=
