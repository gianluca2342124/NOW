# --- NOW environment variables ---

# REQUIRED: Mapbox GL public access token.
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# OPTIONAL: Custom Mapbox Studio style URL for the premium NOW look.
# Falls back to "mapbox://styles/mapbox/dark-v11" when unset.
VITE_MAPBOX_STYLE=

# --- Server-side only (used by /api/activities — NEVER exposed to the client) ---

# Barcelona Open Data (CKAN). No key required. Optional overrides:
# Comma-separated CKAN dataset ids to ingest (defaults to the cultural agenda).
BCN_OPENDATA_DATASET_IDS=
# Force a specific CKAN datastore resource id (skips dataset discovery).
BCN_OPENDATA_RESOURCE_ID=

# Ticketmaster Discovery API (real city-wide search). Optional.
TICKETMASTER_API_KEY=

# Songkick API (concerts). Optional. Barcelona metro id defaults to 28714.
SONGKICK_API_KEY=
SONGKICK_METRO_ID=

# Bandsintown (prepared adapter; requires partner access for city coverage).
BANDSINTOWN_APP_ID=
